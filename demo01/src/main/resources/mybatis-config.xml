<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration
        PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>
    <!-- 加载数据库连接配置 -->
    <properties resource="db.properties"/>

    <settings>
        <!-- 扫描 Mapper 时忽略外部卷的隐藏元数据，不触碰原始隐藏文件。 -->
        <setting name="vfsImpl" value="com.example.util.VisibleFilesVfs"/>
        <!-- 开启驼峰命名自动映射 -->
        <setting name="mapUnderscoreToCamelCase" value="true"/>
        <!-- 开启延迟加载：访问关联属性时才执行嵌套查询 -->
        <setting name="lazyLoadingEnabled" value="true"/>
        <!-- 关闭积极加载：访问普通属性不加载全部关联属性 -->
        <setting name="aggressiveLazyLoading" value="false"/>
        <!-- 打印 SQL 日志：使用项目已有的 Log4j 控制台配置 -->
        <setting name="logImpl" value="LOG4J"/>
    </settings>

    <!-- 实体类别名：Mapper XML 中可直接写 Customer / BankAccount / BankTransaction -->
    <typeAliases>
        <package name="com.example.entity"/>
    </typeAliases>

    <!--
      分页插件不在这里配置：MybatisPlusInterceptor 需要注入 InnerInterceptor 列表，
      MyBatis 的 <property> 只能注入字符串属性，写在 XML 中会导致分页内部拦截器丢失。
      本项目在 MyBatisUtil#createSqlSessionFactory 中用代码注册：
      MybatisPlusInterceptor + PaginationInnerInterceptor(DbType.MYSQL)。
    -->

    <environments default="development">
        <environment id="development">
            <transactionManager type="JDBC"/>
            <dataSource type="POOLED">
                <property name="driver" value="${jdbc.driver}"/>
                <property name="url" value="${jdbc.url}"/>
                <property name="username" value="${jdbc.username}"/>
                <property name="password" value="${jdbc.password}"/>
            </dataSource>
        </environment>
    </environments>

    <!-- XML 位于 mapper/ 目录，显式加载；接口统一按实际包名扫描。 -->
    <mappers>
        <mapper resource="mapper/CustomerMapper.xml"/>
        <mapper resource="mapper/BankAccountMapper.xml"/>
        <mapper resource="mapper/BankTransactionMapper.xml"/>
        <package name="com.example.mapper"/>
    </mappers>
</configuration>
