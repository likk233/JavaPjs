# =========================================================
# .gitignore
# 忽略：macOS 系统垃圾文件 / IntelliJ IDEA 垃圾文件 / VS Code 垃圾文件
# =========================================================

# ---------------------------------------------------------
# 1. macOS 系统垃圾文件
# ---------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.fseventsd
.DocumentRevisions-V100
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDouble
.LSOverride
Icon
*.icloud
Icon?

# ---------------------------------------------------------
# 2. IntelliJ IDEA / JetBrains 垃圾文件
# ---------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
*.ids
out/
!**/src/main/**/out/
!**/src/test/**/out/

# ---------------------------------------------------------
# 3. Visual Studio Code 垃圾文件
# ---------------------------------------------------------
.vscode/
# 如果团队需要共享以下配置，可取消对应行的注释：
# !.vscode/settings.json
# !.vscode/tasks.json
# !.vscode/launch.json
# !.vscode/extensions.json
*.code-workspace
*.vsix

# ---------------------------------------------------------
# 4. 其他编辑器 / 系统临时文件
# ---------------------------------------------------------
.history/
*.swp
*.swo
*~
